# Copie para .env. Este arquivo tem exemplos públicos; .env deve ficar privado.
# Preencha os três segredos com valores diferentes e gerados aleatoriamente.
POSTGRES_DB=mindarena
POSTGRES_USER=mindarena_user
POSTGRES_PASSWORD=
ORGANIZER_PASSWORD=
DEVICE_SECRET=

# Produção: seu domínio, sem https://, porta ou caminho.
# Não é usado na configuração Docker local.
DOMAIN_NAME=arena.example.org

# O backend no Docker recebe automaticamente as credenciais acima.
# Executar o Java diretamente exige exportar suas variáveis no terminal/IDE.

# Exemplo genérico público. false impede a criação do exemplo em bancos novos.
SEED_DEMO_QUIZ=true

# Retenção de resultados em dias (0 desativa a limpeza).
GAME_RETENTION_DAYS=30
MAX_ACTIVE_GAMES=20
MAX_STORED_GAMES=5000
MAX_QUIZZES=500
