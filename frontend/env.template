# Por padrão, API e WebSocket usam o mesmo endereço da interface.
# O Vite encaminha /api e /ws ao backend local; o Nginx faz isso no Docker.
# Defina estas opções somente se hospedar a interface e o backend separadamente.
VITE_BACKEND_URL=
VITE_WS_URL=

# Apenas desenvolvimento: destino do proxy do Vite (não é enviado ao navegador).
BACKEND_PROXY_URL=http://127.0.0.1:8080
